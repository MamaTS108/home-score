# --- Supabase ---
# Project Settings > API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by API routes to bypass RLS for the no-login MVP flow
# (see src/lib/supabase/admin.ts for why). NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic ---
# https://console.anthropic.com/settings/keys
# Powers room vision analysis, renovation planning and the iteration assistant.
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI (recommended for AI visualization) ---
# https://platform.openai.com/api-keys
# Powers the real "before/after" AI visualization (gpt-image-1). Requires
# billing enabled on your OpenAI account (Settings > Billing).
OPENAI_API_KEY=

# --- Google Gemini (alternative to OpenAI, optional) ---
# https://aistudio.google.com/apikey
# Used instead of OpenAI if OPENAI_API_KEY is not set. Note: the image model
# may be gated to limited/preview access on some Google Cloud accounts even
# with billing enabled — OpenAI is the more reliably available option today.
# If neither key is set, the app falls back to showing the original photo
# instead of a generated render (honest placeholder, no fake image).
GEMINI_API_KEY=

# --- Stripe ---
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# https://dashboard.stripe.com/webhooks — create an endpoint pointing to
# /api/webhooks/stripe, listening for: checkout.session.completed,
# customer.subscription.updated, customer.subscription.deleted.
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from https://dashboard.stripe.com/products — create two products:
# 1. "Premium" — recurring monthly price (e.g. 9.99€/mo)
# 2. "Débloquer un projet" — one-time price (e.g. 4.99€)
STRIPE_PRICE_PREMIUM=price_...
STRIPE_PRICE_UNLOCK_PROJECT=price_...

# --- Resend (emails) ---
# https://resend.com/api-keys
RESEND_API_KEY=re_...
# Must be a domain you've verified in Resend, or use the default
# onboarding@resend.dev for quick testing (limited to your own verified email).
EMAIL_FROM=Teelte <onboarding@resend.dev>
# Where you get notified of new product/artisan interest signups.
ADMIN_EMAIL=you@example.com
